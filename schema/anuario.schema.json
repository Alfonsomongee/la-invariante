{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lainvariante.es/schema/anuario.schema.json",
  "title": "Anuario anual — La Invariante",
  "description": "Esquema de validación para el contexto institucional de cada año (content/anuarios/AAAA.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anio",
    "legislatura",
    "gobiernos",
    "composicion_congreso",
    "gobiernos_autonomicos",
    "contexto_resumen",
    "nota_exposicion",
    "fuentes",
    "estado_anuario",
    "versiones"
  ],
  "properties": {
    "anio": {
      "type": "integer",
      "minimum": 1977,
      "maximum": 2100
    },
    "legislatura": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "moneda_curso": {
      "type": "string",
      "enum": ["ESP", "EUR"]
    },
    "gobiernos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["presidente", "partido", "tipo_mayoria", "desde"],
        "properties": {
          "presidente": { "type": "string", "minLength": 2 },
          "partido": { "type": "string", "minLength": 2 },
          "coalicion": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tipo_mayoria": {
            "type": "string",
            "enum": ["mayoria_absoluta", "mayoria_simple", "coalicion", "minoria_apoyo_parlamentario", "en_funciones"]
          },
          "desde": { "type": "string", "format": "date" },
          "hasta": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "composicion_congreso": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partido", "escanos"],
        "properties": {
          "partido": { "type": "string", "minLength": 2 },
          "escanos": { "type": "integer", "minimum": 0, "maximum": 350 }
        }
      }
    },
    "gobiernos_autonomicos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comunidad", "presidente", "partido"],
        "properties": {
          "comunidad": { "type": "string", "minLength": 2 },
          "presidente": { "type": "string", "minLength": 2 },
          "partido": { "type": "string", "minLength": 2 }
        }
      }
    },
    "contexto_resumen": {
      "type": "string",
      "minLength": 20,
      "description": "Máximo 150 palabras. Gobierno, composición del Congreso, gobiernos autonómicos y hitos del año."
    },
    "nota_exposicion": {
      "type": "string",
      "minLength": 15,
      "description": "Declaración explícita del efecto de exposición según quién ostenta el poder ejecutivo en el año."
    },
    "hitos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fecha", "descripcion", "fuente_url"],
        "properties": {
          "fecha": { "type": "string", "format": "date" },
          "descripcion": { "type": "string", "minLength": 5 },
          "fuente_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "descartes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pista", "motivo_descarte", "requisito_entrada"],
        "properties": {
          "pista": { "type": "string", "minLength": 3 },
          "motivo_descarte": { "type": "string", "minLength": 5 },
          "requisito_entrada": { "type": "string", "minLength": 5 }
        }
      }
    },
    "cobertura": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notas": { "type": "string" },
        "huecos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "documentos_manuales": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ficha.schema.json#/definitions/fuente" }
    },
    "estado_anuario": {
      "type": "string",
      "enum": ["borrador", "revision", "publicado"]
    },
    "versiones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ficha.schema.json#/definitions/version" }
    }
  }
}
