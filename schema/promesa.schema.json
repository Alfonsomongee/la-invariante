{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lainvariante.es/schema/promesa.schema.json",
  "title": "Promesa frente a BOE (Dijo / Firmó) — La Invariante",
  "description": "Esquema de validación para fichas comparativas Dijo / Firmó (content/promesas/AAAA/ID.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "anuario",
    "categoria",
    "partidos",
    "nivel",
    "titulo",
    "resumen",
    "dijo",
    "firmo",
    "descargo",
    "fuentes",
    "imagen",
    "estado_ficha",
    "versiones"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ES-(197[7-9]|19[89]\\d|20\\d\\d)-PRM-\\d{3}$"
    },
    "anuario": {
      "type": "integer",
      "minimum": 1977,
      "maximum": 2100
    },
    "categoria": {
      "const": "PRM"
    },
    "contraprueba": {
      "type": "boolean",
      "default": false
    },
    "contraprueba_motivo": {
      "type": ["string", "null"]
    },
    "partidos": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      }
    },
    "nivel": {
      "type": "string",
      "enum": ["estatal", "autonomico", "local"]
    },
    "ambito_territorial": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "protagonistas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nombre", "cargo_en_el_momento", "cargo_publico"],
        "properties": {
          "nombre": { "type": "string", "minLength": 2, "maxLength": 140 },
          "cargo_en_el_momento": { "type": "string", "minLength": 2, "maxLength": 180 },
          "cargo_publico": { "type": "boolean" },
          "wikidata": { "type": ["string", "null"], "pattern": "^Q\\d+$" }
        }
      }
    },
    "titulo": {
      "type": "string",
      "minLength": 5,
      "maxLength": 140
    },
    "resumen": {
      "type": "string",
      "minLength": 15
    },
    "dijo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fecha",
        "autor",
        "cargo_en_el_momento",
        "cargo_publico",
        "partido",
        "cita_literal",
        "contexto",
        "fuente_url"
      ],
      "properties": {
        "fecha": { "type": "string", "format": "date" },
        "autor": { "type": "string", "minLength": 2, "maxLength": 140 },
        "cargo_en_el_momento": { "type": "string", "minLength": 2, "maxLength": 180 },
        "cargo_publico": { "type": "boolean" },
        "wikidata": { "type": ["string", "null"], "pattern": "^Q\\d+$" },
        "partido": { "type": "string", "minLength": 2, "maxLength": 40 },
        "cita_literal": { "type": "string", "minLength": 5 },
        "contexto": { "type": "string", "minLength": 5, "maxLength": 240 },
        "fuente_url": { "type": "string", "format": "uri" }
      }
    },
    "firmo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fecha", "organismo", "norma_o_acto", "descripcion_factual", "fuente_url"],
      "properties": {
        "fecha": { "type": "string", "format": "date" },
        "organismo": { "type": "string", "minLength": 2, "maxLength": 180 },
        "norma_o_acto": { "type": "string", "minLength": 3, "maxLength": 240 },
        "descripcion_factual": { "type": "string", "minLength": 10 },
        "fuente_url": { "type": "string", "format": "uri" }
      }
    },
    "descargo": {
      "type": ["string", "null"]
    },
    "descargo_justificacion_null": {
      "type": ["string", "null"]
    },
    "cifras": {
      "type": "array",
      "items": { "$ref": "ficha.schema.json#/definitions/cifra" }
    },
    "fuentes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "ficha.schema.json#/definitions/fuente" },
      "description": "Requiere al menos la fuente de la promesa y la fuente del acto o norma."
    },
    "imagen": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "ficha.schema.json#/definitions/imagen" }
      ]
    },
    "estado_ficha": {
      "type": "string",
      "enum": ["borrador", "revision", "publicada", "retirada"]
    },
    "motivo_retirada": {
      "type": ["string", "null"]
    },
    "versiones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ficha.schema.json#/definitions/version" }
    },
    "investigacion": {
      "$ref": "ficha.schema.json#/definitions/investigacion"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "estado_ficha": { "const": "retirada" } },
        "required": ["estado_ficha"]
      },
      "then": {
        "required": ["motivo_retirada"],
        "properties": {
          "motivo_retirada": { "type": "string", "minLength": 5 }
        }
      }
    }
  ]
}
