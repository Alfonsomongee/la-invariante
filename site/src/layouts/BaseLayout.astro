---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description = 'Archivo hemerográfico y documental del funcionamiento institucional en España desde 1977 hasta hoy.',
  noindex = false,
  ogImage = '/og/default.png',
  canonicalPath,
} = Astro.props;

const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? 'https://lainvariante.es';
const currentPath = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = `${siteBase}${currentPath}`;
const ogUrl = ogImage.startsWith('http') ? ogImage : `${siteBase}${ogImage}`;
const fechaConsulta = new Date().toISOString().slice(0, 10);

const isArchiveSection =
  currentPath.startsWith('/fichas/') ||
  currentPath.startsWith('/promesas/') ||
  currentPath.startsWith('/votaciones/') ||
  currentPath.startsWith('/categorias/') ||
  currentPath.startsWith('/partidos/') ||
  currentPath.startsWith('/personas/');

const navItems = [
  { href: '/anuarios/', label: 'Anuarios', active: currentPath.startsWith('/anuarios/') },
  { href: '/fichas/', label: 'Archivo', active: isArchiveSection },
  { href: '/series/', label: 'Series', active: currentPath.startsWith('/series/') },
  { href: '/contraprueba/', label: 'Contraprueba', active: currentPath.startsWith('/contraprueba/') },
  { href: '/metodologia/', label: 'Metodología', active: currentPath.startsWith('/metodologia/') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — La Invariante</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="La Invariante" />
    <meta property="og:title" content={`${title} — La Invariante`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — La Invariante`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand-group">
          <a href="/" class="site-brand">La Invariante</a>
          <span class="site-edition">1977–hoy</span>
        </div>
        <nav class="site-nav" aria-label="Navegación principal">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a
            href="/buscar/"
            class="nav-search"
            aria-current={currentPath.startsWith('/buscar/') ? 'page' : undefined}
          >
            Buscar
          </a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <div class="print-meta">
          La Invariante · {canonicalUrl} · Fecha de compilación/consulta: {fechaConsulta}
        </div>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-note">
          <strong>La Invariante</strong> — Archivo documental de las instituciones españolas desde 1977.
          Documento primario obligatorio, sin colores de partido ni adjetivos valorativos.
        </div>
        <div class="footer-links">
          <a href="/promesas/">Dijo / Firmó</a>
          <a href="/votaciones/">Votan juntos</a>
          <a href="/partidos/">Partidos</a>
          <a href="/personas/">Cargos públicos</a>
          <a href="/erratas/">Fe de erratas</a>
          <a href="/rectificacion/">Rectificación</a>
        </div>
      </div>
    </footer>
  </body>
</html>
