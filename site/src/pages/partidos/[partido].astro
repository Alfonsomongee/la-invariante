---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordCard from '../../components/RecordCard.astro';
import { getPartidos } from '../../lib/content.js';

export function getStaticPaths() {
  return getPartidos().map((p) => ({
    params: { partido: p.sigla },
    props: { sigla: p.sigla, registros: p.registros },
  }));
}

interface Props {
  sigla: string;
  registros: ReturnType<typeof getPartidos>[number]['registros'];
}

const { sigla, registros } = Astro.props;
---

<BaseLayout
  title={`Partido: ${sigla}`}
  description={`Registros documentales en los que figura ${sigla} en La Invariante.`}
>
  <nav class="breadcrumb" aria-label="Ruta de partido">
    <div class="breadcrumb-trail">
      <a href="/partidos/" class="crumb">← Todos los partidos</a>
    </div>
  </nav>

  <section class="reading">
    <span class="section-kicker">Siglas en el momento de los hechos</span>
    <h1>{sigla} ({registros.length})</h1>
    <p class="muted">
      Agrupación estrictamente analítica por siglas vigentes en la fecha de los hechos.
    </p>
  </section>

  <ul class="record-list">
    {registros.map((r) => (
      <RecordCard record={r} />
    ))}
  </ul>
</BaseLayout>
