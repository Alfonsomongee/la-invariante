---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveSubnav from '../../components/ArchiveSubnav.astro';
import { getPersonasPublicas } from '../../lib/content.js';

const personas = getPersonasPublicas();
---

<BaseLayout
  title="Cargos públicos"
  description="Índice exclusivo de personas que ostentaron cargo público (STC 58/2018), restringido a hechos vinculados al ejercicio de su cargo."
>
  <section class="reading">
    <span class="section-kicker">Privacidad y STC 58/2018</span>
    <h1>Cargos públicos ({personas.length})</h1>
    <p class="lead">
      Este índice incluye exclusivamente a personas que ostentaban cargo público en el momento de los
      hechos (<code>cargo_publico: true</code>), y solo recoge actos vinculados al ejercicio de dicho cargo.
    </p>
  </section>

  <ArchiveSubnav active="personas" />

  {personas.length === 0 ? (
    <div class="box reading">Sin fichas de cargos públicos publicadas todavía.</div>
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Cargos documentados</th>
            <th>Partidos</th>
            <th class="num">Registros</th>
          </tr>
        </thead>
        <tbody>
          {personas.map((p) => (
            <tr>
              <td>
                <a href={`/personas/${p.slug}/`}><strong>{p.nombre}</strong></a>
              </td>
              <td>{p.cargos.join('; ')}</td>
              <td class="mono">{p.partidos.join(', ')}</td>
              <td class="num">{p.registros.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</BaseLayout>
