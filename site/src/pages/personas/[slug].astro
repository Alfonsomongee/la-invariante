---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordCard from '../../components/RecordCard.astro';
import { getPersonasPublicas, type PersonaPublica } from '../../lib/content.js';

export function getStaticPaths() {
  // Regla §8: getPersonasPublicas() filtra estrictamente cargo_publico === true
  return getPersonasPublicas().map((persona) => ({
    params: { slug: persona.slug },
    props: { persona },
  }));
}

interface Props {
  persona: PersonaPublica;
}

const { persona } = Astro.props;
---

<BaseLayout
  title={persona.nombre}
  description={`Registros vinculados al ejercicio del cargo público de ${persona.nombre} en La Invariante.`}
>
  <nav class="breadcrumb" aria-label="Ruta de cargo público">
    <div class="breadcrumb-trail">
      <a href="/personas/" class="crumb">← Cargos públicos</a>
    </div>
  </nav>

  <section class="reading" style="margin-bottom:2rem;">
    <span class="section-kicker">Cargo público documentado</span>
    <h1>{persona.nombre}</h1>
    <p class="lead">
      {persona.cargos.join(' · ')}
      {persona.wikidata && (
        <span class="mono" style="margin-left:0.5rem;">
          <a href={`https://www.wikidata.org/wiki/${persona.wikidata}`} target="_blank" rel="noopener noreferrer">
            Wikidata {persona.wikidata} ↗
          </a>
        </span>
      )}
    </p>
    <p class="muted" style="font-size:0.88rem;">
      Esta página reúne exclusivamente hechos documentados relativos al ejercicio de un cargo público.
    </p>
  </section>

  <ul class="record-list">
    {persona.registros.map((r) => (
      <RecordCard record={r} />
    ))}
  </ul>
</BaseLayout>
