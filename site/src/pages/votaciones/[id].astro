---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StampBadge from '../../components/StampBadge.astro';
import MarginSources from '../../components/MarginSources.astro';
import { getVotaciones, hasNonPublicProtagonist, type Votacion } from '../../lib/content.js';
import { renderVotacionSvg } from '../../lib/charts.js';

export function getStaticPaths() {
  return getVotaciones({ includeRetiradas: true }).map((votacion) => ({
    params: { id: votacion.id },
    props: { votacion },
  }));
}

interface Props {
  votacion: Votacion;
}

const { votacion } = Astro.props;
const esRetirada = votacion.estado_ficha === 'retirada';
const noindex = esRetirada || hasNonPublicProtagonist(votacion);
const svgChart = esRetirada ? '' : renderVotacionSvg(votacion);

const sentidoLabel: Record<string, string> = {
  a_favor: 'A favor',
  en_contra: 'En contra',
  abstencion: 'Abstención',
  dividido: 'Dividido',
  ausente: 'Ausente',
};
---

<BaseLayout
  title={`${votacion.id} — ${votacion.titulo}`}
  description={votacion.resumen}
  noindex={noindex}
  ogImage={esRetirada ? '/og/default.png' : `/og/${votacion.id}.png`}
>
  <p class="mono muted" style="margin-bottom:0.5rem;">
    <a href="/votaciones/">← Votan juntos</a> · <a href={`/anuarios/${votacion.anuario}/`}>Anuario {votacion.anuario}</a>
  </p>

  {esRetirada ? (
    <article class="reading">
      <StampBadge label="Ficha retirada" />
      <h1>{votacion.id}</h1>
      <div class="box box--stamp">{votacion.motivo_retirada}</div>
    </article>
  ) : (
    <article class="doc-grid" data-pagefind-body>
      <div class="doc-main">
        <div class="record-meta" style="margin-bottom:0.6rem;">
          <strong>{votacion.id}</strong>
          <span>·</span>
          <span>{votacion.sesion.fecha}</span>
          <span>·</span>
          <span>{votacion.sesion.legislatura} ({votacion.sesion.camara})</span>
        </div>

        <h1>{votacion.titulo}</h1>
        <p>{votacion.resumen}</p>

        <figure class="chart-figure">
          <div set:html={svgChart} />
          <figcaption class="chart-caption">
            Asunto: {votacion.sesion.asunto}
            {votacion.sesion.norma_resultante && ` · Norma resultante: ${votacion.sesion.norma_resultante}`}
          </figcaption>
        </figure>

        <h2>Sentido del voto por grupo parlamentario</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Grupo parlamentario</th>
                <th>Partido</th>
                <th>Sentido</th>
                <th class="num">A favor</th>
                <th class="num">En contra</th>
                <th class="num">Abstenciones</th>
              </tr>
            </thead>
            <tbody>
              {votacion.grupos.map((g) => (
                <tr>
                  <td>{g.grupo}</td>
                  <td class="mono">
                    <a href={`/partidos/${encodeURIComponent(g.partido)}/`}>{g.partido}</a>
                  </td>
                  <td><strong>{sentidoLabel[g.sentido] ?? g.sentido}</strong></td>
                  <td class="num">{g.a_favor ?? '—'}</td>
                  <td class="num">{g.en_contra ?? '—'}</td>
                  <td class="num">{g.abstenciones ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <section aria-labelledby="descargo-vot">
          <h2 id="descargo-vot">Descargo y posiciones expresadas</h2>
          {votacion.descargo ? (
            <div class="box box--notice"><p style="margin:0;">{votacion.descargo}</p></div>
          ) : (
            <p class="muted">
              No consta descargo registrado.
              {votacion.descargo_justificacion_null && ` (${votacion.descargo_justificacion_null})`}
            </p>
          )}
        </section>

        <div class="mobile-only">
          <details>
            <summary>Fuentes primarias ({votacion.fuentes.length})</summary>
            <MarginSources fuentes={votacion.fuentes} />
          </details>
        </div>

        <p class="mono no-print" style="margin-top:1.5rem;">
          <a href={`/rectificacion/?ficha=${encodeURIComponent(votacion.id)}`}>
            Solicitar réplica o rectificación para {votacion.id} →
          </a>
        </p>
      </div>

      <aside class="doc-margin" aria-label="Fuentes al margen">
        <h3 style="margin-top:0;">Fuentes ({votacion.fuentes.length})</h3>
        <MarginSources fuentes={votacion.fuentes} />
      </aside>
    </article>
  )}
</BaseLayout>
