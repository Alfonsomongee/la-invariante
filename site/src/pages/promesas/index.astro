---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveSubnav from '../../components/ArchiveSubnav.astro';
import RecordCard from '../../components/RecordCard.astro';
import { getPromesas, type AnyRecord } from '../../lib/content.js';

const promesas: AnyRecord[] = getPromesas().map((p) => ({
  ...p,
  _tipo: 'promesa',
  _rutaUrl: `/promesas/${p.id}/`,
}));
---

<BaseLayout
  title="Promesas frente a BOE (Dijo / Firmó)"
  description="Comparativa documental entre compromisos literales fechados y normas o actos contrarios publicados en el BOE."
>
  <section class="reading">
    <span class="section-kicker">Promesas frente a BOE</span>
    <h1>Dijo / Firmó ({promesas.length})</h1>
    <p class="lead">
      Cada entrada contrasta una cita literal fechada (programa electoral, Diario de Sesiones o
      documento oficial) con la norma o acto contrario publicado posteriormente en el BOE.
    </p>
  </section>

  <ArchiveSubnav active="promesas" />

  {promesas.length === 0 ? (
    <div class="box reading">
      Sin fichas Dijo / Firmó publicadas todavía.
    </div>
  ) : (
    <ul class="record-list">
      {promesas.map((p) => (
        <RecordCard record={p} />
      ))}
    </ul>
  )}
</BaseLayout>
