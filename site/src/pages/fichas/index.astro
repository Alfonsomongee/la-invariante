---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveSubnav from '../../components/ArchiveSubnav.astro';
import RecordCard from '../../components/RecordCard.astro';
import { CATEGORIAS, getAllPublishedRecords, type CategoriaCodigo } from '../../lib/content.js';

const records = getAllPublishedRecords();
---

<BaseLayout
  title="Archivo documental"
  description="Catálogo completo de fichas, promesas y votaciones verificadas con documentos primarios en La Invariante."
>
  <section class="reading">
    <span class="section-kicker">Catálogo completo</span>
    <h1>Archivo documental ({records.length})</h1>
    <p class="lead">
      Todas las entradas cumplen los criterios de <a href="/metodologia/">Metodología</a>, enlazan
      documento primario con huella SHA-256 y pasan validación de estado procesal y estilo neutro.
    </p>
  </section>

  <ArchiveSubnav active="fichas" />

  <nav class="filter-bar" aria-label="Filtrar por categoría">
    {(Object.keys(CATEGORIAS) as CategoriaCodigo[]).map((code) => (
      <a href={`/categorias/${code.toLowerCase()}/`} class="tag">
        {code} · {CATEGORIAS[code].nombre}
      </a>
    ))}
  </nav>

  {records.length === 0 ? (
    <div class="box reading">
      Todavía no hay fichas publicadas. Cada ficha entra mediante pull request y revisión humana.
    </div>
  ) : (
    <ul class="record-list">
      {records.map((r) => (
        <RecordCard record={r} />
      ))}
    </ul>
  )}
</BaseLayout>
