# =============================================================================
# La Invariante — Variables de entorno (copiar a .env para uso local)
# En producción y CI, guardar exclusivamente en GitHub Secrets. Nunca en Git.
# =============================================================================

# --- Proveedores de modelos (Extractor y Verificador DEBEN usar modelos distintos) ---
# Proveedores soportados: anthropic | openai | gemini
EXTRACTOR_PROVIDER=anthropic
EXTRACTOR_MODEL=claude-sonnet-4-5
VERIFICADOR_PROVIDER=openai
VERIFICADOR_MODEL=gpt-4.1
JURISTA_PROVIDER=anthropic
JURISTA_MODEL=claude-sonnet-4-5
EDITOR_PROVIDER=anthropic
EDITOR_MODEL=claude-sonnet-4-5

# Claves API (rellenar solo las de los proveedores que uses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Almacenamiento de documentos primarios (Cloudflare R2, compatible S3) ---
# Los documentos originales NO se guardan en Git; se suben con nombre = <sha256>
R2_ACCOUNT_ID=
R2_BUCKET=la-invariante-docs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# --- GitHub (para que los agentes abran PRs, NUNCA fusionan) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# --- URL pública del sitio (para metadatos, sitemap y tarjetas OG) ---
SITE_URL=https://lainvariante.es
# URL o correo del canal de réplica y rectificación
RECTIFICACION_URL=https://github.com/OWNER/la-invariante/issues/new?template=rectificacion.md
RECTIFICACION_EMAIL=rectificacion@lainvariante.es
